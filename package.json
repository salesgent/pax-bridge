{
  "name": "pax-bridge-desktop",
  "productName": "Salesgent Pax Bridge",
  "version": "1.0.6",
  "description": "Installable, auto-updating desktop app that runs the Salesgent PAX payment bridge on a store computer.",
  "author": "Salesgent",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:dmg": "tauri build --bundles dmg",
    "build:nsis": "tauri build --bundles nsis",
    "build:server": "cargo build --release --manifest-path src-tauri/Cargo.toml --features bridge-server --bin pax-bridge-server",
    "test:api": "node scripts/test-bridge-apis.mjs",
    "icons": "tauri icon build/icon.png",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}

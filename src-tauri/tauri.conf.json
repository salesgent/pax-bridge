{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Salesgent Hardware Bridge",
  "version": "1.0.1",
  "identifier": "com.salesgent.paxbridge",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Salesgent Hardware Bridge",
        "width": 1040,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' data: asset: http://asset.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "publisher": "Salesgent",
    "copyright": "Copyright © Salesgent",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NzgyMUQzNEI2MjIwRDYKUldUV0lHSkwweUY0MS9TTS8rZ0h6bDVKd2lPNzI3TzZsTDZyWU1ZdmgzaHhlRjdKYzRDSm5jT2cK",
      "endpoints": [
        "https://github.com/mp-salesgent/pax-bridge/releases/latest/download/latest.json"
      ]
    }
  }
}
